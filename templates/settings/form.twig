{% extends baseLayout %}

{% block contentHeader %}
    <div class="content-header-top">
        <h1>CustomModule Settings</h1>
    </div>

    <div class="content-header-tabs">
        {{ tabs|raw }}
    </div>
{% endblock %}

{% block content %}
    <div class="content-in content-widgetable">
        <div class="content-scroll">
            <div class="panel">
                <div class="panel-body">
                    {{ form|raw }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
